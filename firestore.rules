rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /cases/{caseId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
